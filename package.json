{
  "name": "gittygo",
  "productName": "GittyGo",
  "version": "0.1.0-alpha.1",
  "description": "Git review for humans and agents.",
  "license": "MIT",
  "author": {
    "name": "Mohammad Bashiri",
    "email": "mohammadbashiri93@gmail.com"
  },
  "private": true,
  "main": "src/main.cjs",
  "bin": {
    "gittygo": "bin/gittygo.cjs"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist:mac": "electron-builder --mac --arm64",
    "dist:mac:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac zip --arm64"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2"
  },
  "build": {
    "appId": "io.github.mohammadbashiri.gittygo",
    "productName": "GittyGo",
    "asar": true,
    "files": [
      "src/**/*",
      "bin/**/*",
      "skills/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts/gittygo",
        "to": "bin/gittygo"
      },
      {
        "from": "scripts/gittygo-uninstall",
        "to": "bin/gittygo-uninstall"
      },
      {
        "from": "skills/gittygo",
        "to": "skills/gittygo"
      }
    ],
    "artifactName": "GittyGo-${version}-${arch}.${ext}",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        },
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ]
    }
  }
}
